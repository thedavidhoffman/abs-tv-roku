import "pkg:/source/Color.bs"
import "pkg:/source/Logger.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.log = Logger.CreateLogger("Starfield")
    m.starLayer = m.top.findNode("starLayer")
    m.starTimer = m.top.findNode("starTimer")

    initValues()
    initHandlers()
    buildStars()
    startStarfield()
end sub

'-------------------------------------------------------------------------------
' initValues
'-------------------------------------------------------------------------------
sub initValues()
    m.screenWidth = 1920
    m.screenHeight = 1080
    m.centerX = m.screenWidth / 2
    m.centerY = m.screenHeight / 2
    m.starCount = 150
    m.starSpeed = 0.009
    m.stars = []
end sub

'-------------------------------------------------------------------------------
' initHandlers
'-------------------------------------------------------------------------------
sub initHandlers()
    if m.starTimer <> invalid then m.starTimer.observeField("fire", "onStarTimerFired")
end sub

'-------------------------------------------------------------------------------
' buildStars
'-------------------------------------------------------------------------------
sub buildStars()
    if m.starLayer = invalid then return

    childCount = m.starLayer.getChildCount()
    if childCount > 0 then m.starLayer.removeChildrenIndex(childCount, 0)
    m.stars = []

    for i = 0 to m.starCount - 1
        starNode = CreateObject("roSGNode", "Rectangle")
        starNode.width = 1
        starNode.height = 1
        starNode.color = &hFFFFFFFF
        m.starLayer.appendChild(starNode)

        star = {
            node: starNode
            worldX: 0.0
            worldY: 0.0
            z: 1.0
            driftX: 0.0
            driftY: 0.0
        }
        resetStar(star, false)
        m.stars.Push(star)
    end for
end sub

'-------------------------------------------------------------------------------
' startStarfield
'-------------------------------------------------------------------------------
sub startStarfield()
    if m.starTimer = invalid then return

    m.starTimer.control = "stop"
    m.starTimer.control = "start"
end sub

'-------------------------------------------------------------------------------
' onStarTimerFired
'-------------------------------------------------------------------------------
sub onStarTimerFired()
    for each star in m.stars
        updateStar(star)
    end for
end sub

'-------------------------------------------------------------------------------
' updateStar
'-------------------------------------------------------------------------------
sub updateStar(star as object)
    star.z = star.z - m.starSpeed
    star.worldX = star.worldX + star.driftX
    star.worldY = star.worldY + star.driftY

    if star.z <= 0.08 then
        resetStar(star, true)
        return
    end if

    screenX = m.centerX + (star.worldX / star.z)
    screenY = m.centerY + (star.worldY / star.z)

    if screenX < -20 or screenX > m.screenWidth + 20 or screenY < -20 or screenY > m.screenHeight + 20 then
        resetStar(star, true)
        return
    end if

    depth = 1.0 - star.z
    starSize = int(1 + (depth * 5))
    if starSize < 1 then starSize = 1
    if starSize > 6 then starSize = 6

    alpha = int(80 + (depth * 175))
    if alpha < 80 then alpha = 80
    if alpha > 255 then alpha = 255

    star.node.width = starSize
    star.node.height = starSize
    star.node.translation = [int(screenX), int(screenY)]
    star.node.color = &hFFFFFF00 + alpha
end sub

'-------------------------------------------------------------------------------
' resetStar
'-------------------------------------------------------------------------------
sub resetStar(star as object, fromCenter as boolean)
    star.worldX = randomRangeFloat(-m.centerX, m.centerX)
    star.worldY = randomRangeFloat(-m.centerY, m.centerY)
    star.driftX = randomRangeFloat(-0.35, 0.35)
    star.driftY = randomRangeFloat(-0.2, 0.2)

    if fromCenter = true then
        star.z = randomRangeFloat(0.85, 1.0)
    else
        star.z = randomRangeFloat(0.12, 1.0)
    end if

    updateStar(star)
end sub

'-------------------------------------------------------------------------------
' randomRangeFloat
'-------------------------------------------------------------------------------
function randomRangeFloat(minValue as float, maxValue as float) as float
    return minValue + (Rnd(0) * (maxValue - minValue))
end function
