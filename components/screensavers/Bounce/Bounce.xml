<?xml version="1.0" encoding="utf-8"?>
<component name="Bounce" extends="Group">
  <interface>
    <field id="server" type="string" onChange="updatePoster" />
    <field id="token" type="string" onChange="updatePoster" />
    <field id="itemId" type="string" onChange="updatePoster" />
  </interface>
  <children>
    <RectanglePrimary id="background" width="1920" height="1080" />
    <Poster
      id="poster"
      translation="[710,290]"
      width="500"
      height="500"
      uri="pkg:/images/placeholder-cover.png"
      loadDisplayMode="scaleToFit" />
    <Animation id="bounceAnimation" easeFunction="linear">
      <Vector2DFieldInterpolator id="bounceInterpolator" fieldToInterp="poster.translation" />
    </Animation>
    <Timer id="bounceLegTimer" repeat="false" />
  </children>
</component>
