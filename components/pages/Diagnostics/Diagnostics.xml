<?xml version="1.0" encoding="utf-8"?>
<component name="Diagnostics" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/source/store/AuthStore.brs" />
  <script type="text/brightscript" uri="pkg:/source/store/SettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Diagnostics/Diagnostics.brs" />
  <interface>
    <field id="closeRequested" type="integer" />
    <function name="openDiagnostics" />
  </interface>
  <children>
    <Group id="diagnosticsDialog" visible="false">
      <Rectangle
        id="diagnosticsBackdrop"
        width="1920"
        height="1080" />
      <Rectangle
        id="diagnosticsPanel"
        translation="[360,90]"
        width="1200"
        height="900" />
      <Label
        id="diagnosticsTitle"
        translation="[420,150]"
        width="1080"
        height="56"
        text="Diagnostics"
        font="font:LargeSystemFont" />
      <Rectangle
        id="diagnosticsTitleRule"
        translation="[420,216]"
        width="1080"
        height="2" />

      <!-- roku device information -->
      <Label
        id="deviceSectionTitle"
        translation="[420,260]"
        width="500"
        height="40"
        text="Roku Device Information"
        font="font:MediumBoldSystemFont" />
      <Label
        id="deviceInfoKeysLabel"
        translation="[420,310]"
        width="260"
        height="330"
        wrap="true"
        font="font:SmallestBoldSystemFont" />
      <Label
        id="deviceInfoValuesLabel"
        translation="[700,310]"
        width="800"
        height="330"
        wrap="true"
        font="font:SmallestSystemFont" />

      <!-- application registry -->
      <Label
        id="registrySectionTitle"
        translation="[420,600]"
        width="1080"
        height="40"
        text="Application Registry"
        font="font:MediumBoldSystemFont" />
      <Label
        id="registryKeysLabel"
        translation="[420,650]"
        width="260"
        height="290"
        wrap="true"
        font="font:SmallestBoldSystemFont" />
      <Label
        id="registryValuesLabel"
        translation="[700,650]"
        width="800"
        height="290"
        wrap="true"
        font="font:SmallestSystemFont" />
    </Group>
  </children>
</component>