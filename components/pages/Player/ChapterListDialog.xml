<?xml version="1.0" encoding="utf-8"?>
<component name="ChapterListDialog" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Formatting.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Player/ChapterListDialog.brs" />
  <interface>
    <field id="tracks" type="array" onChange="onTracksChanged" />
    <field id="currentTrackIndex" type="integer" onChange="onCurrentTrackIndexChanged" />
    <field id="audiobookTitle" type="string" onChange="onAudiobookTitleChanged" />
    <field id="selectedChapter" type="assocarray" />
    <field id="closedCounter" type="integer" />
    <function name="open" />
    <function name="close" />
  </interface>
  <children>
    <Dialog
      id="chapterDialog"
      title="Chapters"
      dialogWidth="1320"
      dialogHeight="850"
      contentComponentName="ChapterListContent" />
  </children>
</component>
