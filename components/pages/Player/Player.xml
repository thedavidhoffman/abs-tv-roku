<?xml version="1.0" encoding="utf-8"?>
<component name="Player" extends="Group">
  <interface>
    <field id="playRequest" type="assocarray" onChange="onPlayRequestChanged" />
    <field id="displaySettings" type="assocarray" onChange="onDisplaySettingsChanged" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="errorResponse" type="assocarray" />
  </interface>
  <children>

    <!-- clock -->
    <Clock id="clock" translation="[1680,40]" clockWidth="176" clockHeight="40" color="0xF6F7FBFF" />

    <!-- poster -->
    <ItemPoster
      id="cover"
      translation="[120,180]"
      posterWidth="500"
      showText="false"
      showProgressBar="false" />

    <!-- source audio badges -->
    <AudioBadges id="audioBadges" translation="[120,704]" />

    <!-- metadata -->
    <Metadata id="metadata" translation="[700,180]" />

    <!-- playback controls -->
    <PlaybackControls id="playbackControls" translation="[700,700]" />

    <!-- video player -->
    <!-- note: useing video player instead of audio player because video player supports suspending the screen saver -->
    <Video
      id="audioPlayer"
      visible="false"
      enableUI="false"
      enableTrickPlay="true"
      disableScreenSaver="false" />

    <!-- dialog for displaying a chapter list for view/selection -->
    <ChapterListDialog id="chapterList" visible="false" />

    <!-- screensaver overlay -->
    <ScreensaverOverlay id="screensaverOverlay" />

    <!-- night mode tint -->
    <Rectangle id="nightModeTint" width="1920" height="1080" color="0x000000BF" visible="false" />

    <!-- timers -->
    <Timer id="progressTimer" duration="1" repeat="true" />
    <Timer id="closeTimer" duration="0.5" repeat="false" />
    <Timer id="hlsRetryTimer" duration="2" repeat="false" />

    <!-- api task -->
    <PlaybackTask id="playbackApiTask" />

  </children>
</component>
