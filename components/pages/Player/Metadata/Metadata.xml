<?xml version="1.0" encoding="utf-8"?>
<component name="Metadata" extends="Group">
  <interface>
    <field id="titleText" type="string" onChange="onTitleTextChanged" />
    <field id="authorText" type="string" onChange="onAuthorTextChanged" />
    <field id="metadataText" type="string" onChange="onMetadataTextChanged" />
    <field id="narratorText" type="string" onChange="onNarratorTextChanged" />
    <field id="descriptionText" type="string" onChange="onDescriptionTextChanged" />
    <function name="descriptionHasFocus" />
    <function name="focusDescription" />
    <function name="canFocusDescription" />
    <function name="dismissDescriptionDialog" />
  </interface>
  <children>
    <ScrollingLabel id="titleLabel" translation="[0,0]" maxWidth="1040" font="font:LargeBoldSystemFont" repeatCount="1" />
    <Label id="authorLabel" translation="[0,50]" width="1040" color="0xB7C5D4FF" />
    <Label id="metadataLabel" translation="[0,100]" width="1040" color="0xB7C5D4FF" font="font:SmallestSystemFont" />
    <Rectangle id="hr" translation="[0,150]" width="1040" height="1" color="0xB7C5D4FF" />
    <Label id="narratorLabel" translation="[0,180]" width="1040" color="0xB7C5D4FF" font="font:SmallestBoldSystemFont" />
    <Description id="description" translation="[0,230]" width="1040" numLines="5" />
  </children>
</component>