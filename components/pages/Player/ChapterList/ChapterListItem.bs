import "pkg:/source/Color.bs"
import "pkg:/source/Format.bs"

'-------------------------------------------------------------------------------
' init
'-------------------------------------------------------------------------------
sub init()
    m.title = m.top.findNode("title")
    m.duration = m.top.findNode("duration")
    m.content = invalid
end sub

'-------------------------------------------------------------------------------
' showContent
'-------------------------------------------------------------------------------
sub showContent()
    if m.content <> invalid then m.content.unobserveFieldScoped("focused")

    item = m.top.itemContent
    m.content = item
    if item = invalid then return

    if m.title <> invalid then m.title.text = Format.FirstNonEmpty([item.title], "")
    if m.duration <> invalid then m.duration.text = Format.FirstNonEmpty([item.description], "")
    if item.focused <> invalid then item.observeFieldScoped("focused", "onFocusedChanged")
end sub

'-------------------------------------------------------------------------------
' focusPercentChanged
'-------------------------------------------------------------------------------
function focusPercentChanged() 
    if m.top.focusPercent > 0
        m.title.color = &h0F1A2AFF
        m.duration.color = &h0F1A2AFF
    else 
        m.title.color = &hF3F7FBFF
        m.duration.color = &h8DA0B5FF
    end if 
end function
