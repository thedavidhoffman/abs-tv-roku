<?xml version="1.0" encoding="utf-8"?>
<component name="PlaybackControls" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/String.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Player/PlaybackControls/PlaybackControls.brs" />
  <interface>
    <field id="trackTitle" type="string" onChange="onTrackTitleChanged" />
    <field id="statusText" type="string" onChange="onStatusTextChanged" />
    <field id="positionSeconds" type="integer" onChange="onProgressChanged" />
    <field id="totalDurationSeconds" type="integer" onChange="onProgressChanged" />
    <field id="chapterMarkerPositions" type="array" onChange="onChapterMarkerPositionsChanged" />
    <field id="isPlaying" type="boolean" onChange="onIsPlayingChanged" />
    <field id="showChapters" type="boolean" onChange="onShowChaptersChanged" />
    <field id="focusedIndex" type="integer" onChange="onFocusedIndexChanged" />
    <field id="selectedAction" type="string" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <field id="scrubEvent" type="assocarray" alwaysNotify="true" />
    <function name="handleKey" />
    <function name="focusProgressBar" />
    <function name="cancelScrub" />
    <function name="isScrubbing" />
    <function name="setScrubPosition" />
    <function name="focusButton" />
    <function name="clearFocus" />
    <function name="getButtonCount" />
    <function name="focusProgress" />
    <function name="showScrubPreview" />
    <function name="hideScrubPreview" />
  </interface>
  <children>
    <Label id="trackTitleLabel" translation="[0,0]" width="1040" />
    <Label id="statusLabel" translation="[0,60]" width="430" color="0xF2C879FF" />
    <MonospaceLabel id="chapterStatusLabel" translation="[320,70]" width="720" horizAlign="right" color="0xB7C5D4FF" font="font:TinySystemFont" characterWidth="20" />

    <Group id="progressGroup" translation="[0,110]">
      <Rectangle id="progressTrack" width="1040" height="12" color="0x555555FF" />
      <Rectangle id="progressFill" width="1" height="12" color="0xE09B42FF" visible="false" />
      <Group id="chapterMarkersGroup" />
      <Rectangle id="progressCrossbar" translation="[0,-10]" width="8" height="32" color="0xF3F7FBFF" visible="false" />
      <MonospaceLabel id="currentTimeLabel" translation="[0,26]" width="220" text="0:00" font="font:SmallerSystemFont" characterWidth="20" />
      <MonospaceLabel id="totalTimeLabel" translation="[820,26]" width="220" horizAlign="right" text="0:00" font="font:SmallerSystemFont" characterWidth="20" />
    </Group>

    <Group id="buttonGroup" translation="[0,185]">
      <PrimaryButton id="playPauseButton" translation="[0,0]" buttonWidth="188" buttonHeight="56" text="Pause" />
      <PrimaryButton id="restartButton" translation="[208,0]" buttonWidth="188" buttonHeight="56" text="Restart" iconUri="pkg:/images/icons/restart.png" />
      <PrimaryButton id="tintButton" translation="[416,0]" buttonWidth="188" buttonHeight="56" text="Tint" iconUri="pkg:/images/icons/tint.png" />
      <PrimaryButton id="chaptersButton" translation="[850,0]" buttonWidth="190" buttonHeight="56" text="Chapters" visible="false" />
    </Group>
  </children>
</component>
