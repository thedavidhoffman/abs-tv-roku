<?xml version="1.0" encoding="utf-8"?>
<component name="HomePage_RowItem" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/pages/HomePage/HomePage_RowItem.brs" />
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChanged" />
    <field id="rowFocusPercent" type="float" onChange="onRowFocusPercentChanged" />
  </interface>
  <children>
    <Group
      id="itemVisual"
      scaleRotateCenter="[160,160]">
      <Poster
        id="coverPoster"
        translation="[10,10]"
        width="300"
        height="300"
        uri="pkg:/images/placeholder_cover.png"
        loadDisplayMode="scaleToFill" />
    </Group>
  </children>
</component>
