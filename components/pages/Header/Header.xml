<?xml version="1.0" encoding="utf-8"?>
<component name="Header" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Formatting.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Header/Header.brs" />
  <interface>
    <field id="menuOpen" type="boolean" />
    <field id="closeMenuToken" type="integer" onChange="onCloseMenuTokenChanged" />
    <field id="username" type="string" onChange="onUsernameChanged" />
    <field id="libraries" type="array" onChange="onLibrariesChanged" />
    <field id="currentLibraryId" type="string" onChange="onCurrentLibraryIdChanged" />
    <field id="homeSelected" type="integer" />
    <field id="librarySelected" type="integer" />
    <field id="seriesSelected" type="integer" />
    <field id="searchSelected" type="integer" />
    <field id="currentLibrarySelected" type="assocarray" />
    <field id="downSelected" type="integer" />
    <field id="backSelected" type="integer" />
    <field id="logoutSelected" type="integer" />
    <field id="overlayRequested" type="assocarray" />
    <function name="focusHeader" />
    <function name="focusSettingsButton" />
    <function name="focusUserMenuButton" />
    <function name="isHomeButtonFocused" />
    <function name="activateLibraryButton" />
    <function name="activateSeriesButton" />
    <function name="activateSearchButton" />
  </interface>
  <children>
    <Rectangle id="headerBg" width="1920" height="100" />
    <Poster
      id="brandLogo"
      translation="[64,30]"
      width="195"
      height="38"
      uri="pkg:/images/abstv-header-logo.png"
      loadDisplayMode="scaleToFit" />

    <HeaderButton id="currentLibraryButton" translation="[300,22]" buttonWidth="300" buttonHeight="56" />

    <Group id="navGroup" translation="[632,22]">
      <HeaderButton id="homeButton" translation="[0,0]" buttonWidth="150" buttonHeight="56" text="Home" />
      <HeaderButton id="libraryButton" translation="[162,0]" buttonWidth="170" buttonHeight="56" text="Library" />
      <HeaderButton id="seriesButton" translation="[344,0]" buttonWidth="160" buttonHeight="56" text="Series" />
      <HeaderButton id="searchButton" translation="[516,0]" buttonWidth="160" buttonHeight="56" text="Search" />
      <HeaderButton id="settingsButton" translation="[688,0]" buttonWidth="180" buttonHeight="56" text="Settings" />
    </Group>

    <HeaderButton id="userMenuButton" translation="[1520,22]" buttonWidth="160" buttonHeight="56" />

    <Clock id="clock" translation="[1680,30]" clockWidth="176" clockHeight="40" color="0xF6F7FBFF" />

    <Group id="menuPanel" visible="false" translation="[1420,102]">
      <Rectangle width="260" height="94" color="0x132235FF" />
      <HeaderButton id="logoutButton" translation="[20,18]" buttonWidth="220" buttonHeight="56" text="Logout" />
    </Group>

    <Group id="libraryMenuPanel" visible="false" translation="[300,102]">
      <Rectangle id="libraryMenuBg" width="340" height="94" color="0x132235FF" />
      <Group id="libraryMenuItems" translation="[20,18]" />
    </Group>

    <!-- timer for pressing up 5 times on the user menu item to display the diagnostics dialog -->
    <Timer id="usernameUpSequenceTimer" duration="2" repeat="false" />
  </children>
</component>
