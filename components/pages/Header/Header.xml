<?xml version="1.0" encoding="utf-8"?>
<component name="Header" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Formatting.brs" />
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Header/Header.brs" />
  <interface>
    <field id="currentTab" type="string" />
    <field id="libraries" type="array" onChange="onLibrariesChanged" />
    <field id="currentLibraryId" type="string" onChange="onCurrentLibraryIdChanged" />
    <field id="menuOpen" type="boolean" />
    <field id="closeMenuToken" type="integer" onChange="onCloseMenuTokenChanged" />
    <field id="librarySelected" type="assocarray" />
    <field id="booksSelected" type="integer" />
    <field id="seriesSelected" type="integer" />
    <field id="logoutSelected" type="integer" />
    <field id="changeServerSelected" type="integer" />
    <function name="focusHeader" />
  </interface>
  <children>
    <Rectangle id="headerBg" width="1920" height="118" color="12112BFF" />
    <Label id="brandLabel" translation="[64,42]" text="ABSTV" color="F6F7FBFF" />

    <Group id="tabGroup" translation="[705,26]">
      <HeaderButton id="booksTab" translation="[0,0]" buttonWidth="180" buttonHeight="56" text="Books" />
      <HeaderButton id="seriesTab" translation="[210,0]" buttonWidth="180" buttonHeight="56" text="Series" />
    </Group>

    <HeaderButton id="libraryButton" translation="[1240,26]" buttonWidth="320" buttonHeight="56" text="Library" />

    <LabelList
      id="libraryList"
      visible="false"
      translation="[1240,102]"
      itemSize="[360,54]"
      numRows="6"
      drawFocusFeedback="true"
    />

    <HeaderButton id="userMenuButton" translation="[1620,26]" buttonWidth="220" buttonHeight="56" text="Account" />

    <Group id="menuPanel" visible="false" translation="[1600,102]">
      <Rectangle width="260" height="150" color="132235FF" />
      <HeaderButton id="logoutButton" translation="[20,18]" buttonWidth="220" buttonHeight="56" text="Logout" />
      <HeaderButton id="changeServerButton" translation="[20,78]" buttonWidth="220" buttonHeight="56" text="Change Server" />
    </Group>
  </children>
</component>
