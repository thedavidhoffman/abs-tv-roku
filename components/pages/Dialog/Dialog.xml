<?xml version="1.0" encoding="utf-8"?>
<component name="Dialog" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/Color.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Dialog/Dialog.brs" />
  <interface>
    <field id="title" type="string" onChange="onTitleChanged" />
    <field id="dialogWidth" type="integer" onChange="onDialogSizeChanged" />
    <field id="dialogHeight" type="integer" onChange="onDialogSizeChanged" />
    <field id="contentComponentName" type="string" onChange="onContentComponentNameChanged" />
    <field id="closeRequested" type="integer" />
    <function name="openDialog" />
    <function name="closeDialog" />
  </interface>
  <children>
    <Group id="dialog" visible="false">
      <Rectangle
        id="backdrop"
        width="1920"
        height="1080" />
      <Rectangle
        id="panel"
        translation="[120,90]"
        width="1680"
        height="900" />
      <Label
        id="titleLabel"
        translation="[180,150]"
        width="1560"
        height="56"
        font="font:LargeSystemFont" />
      <Rectangle
        id="titleRule"
        translation="[180,216]"
        width="1560"
        height="2" />
      <Group
        id="content"
        translation="[180,260]" />
    </Group>
  </children>
</component>
