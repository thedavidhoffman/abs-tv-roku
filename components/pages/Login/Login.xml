<?xml version="1.0" encoding="utf-8"?>
<component name="Login" extends="Group">
  <interface>
    <field id="serverValue" type="string" onChange="onServerValueChanged" />
    <field id="usernameValue" type="string" onChange="onUsernameValueChanged" />
    <field id="passwordValue" type="string" onChange="onPasswordValueChanged" />
    <field id="savedSession" type="assocarray" onChange="onSavedSessionChanged" />
    <field id="statusMessage" type="string" onChange="onStatusMessageChanged" />
    <field id="loginRequested" type="assocarray" />
    <function name="activate" />
  </interface>
  <children>

    <!-- logo -->
    <Poster translation="[150,255]" width="540" height="101" uri="pkg:/images/abstv-logo-medium.png"></Poster>

    <!-- description -->
    <LabelPrimary
      id="loginBody"
      translation="[150,430]"
      width="650"
      numLines="3"
      wrap="true"
      text="Connect your Audiobookshelf server and bring your audiobook library to the couch, bedroom, or anywhere you have a TV." />

    <!-- hr -->
    <Rectangle
      translation="[150, 600]"
      width="650"
      height="2"
      color="0xA8B7C8FF" />

    <!-- privacy -->
    <LabelSecondary
      id="loginPrivacy"
      translation="[150,630]"
      width="650"
      wrap="true"
      font="font:SmallestSystemFont"
      text="This is a free open-source app that respects your privacy and does not track any data." />

    <!-- status -->
    <Label 
      id="loginStatus" 
      translation="[150,750]" 
      width="650" 
      numLines="4" 
      wrap="true" 
      color="0xF2C879FF" />

    <!-- login form -->
    <RectangleSecondary id="loginCard" translation="[972,0]" width="960" height="1080" />

    <Group id="loginForm" translation="[1100,214]">

      <LabelHeading 
        translation="[0,0]" 
        text="Sign In" />
      
      <LabelPrimary 
        translation="[0,64]" 
        width="650" 
        numLines="2" 
        wrap="true" 
        text="To get started please enter your server url, username, and password." />

      <!-- server -->
      <TextInput 
        id="serverInput" 
        translation="[10,186]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter server" />

      <!-- username -->
      <TextInput 
        id="usernameInput" 
        translation="[10,334]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter username" />

      <!-- password -->
      <TextInput id="passwordInput" 
        translation="[10,482]" 
        fieldWidth="680" 
        fieldHeight="84" 
        placeholder="Press OK to enter password" />

      <!-- signin -->
      <PrimaryButton 
        id="loginButton" 
        translation="[0,615]" 
        buttonWidth="300" 
        buttonHeight="56" 
        text="Sign In" />
      
    </Group>
  </children>
</component>
