<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsDialog" extends="Group" focusable="true">
  <interface>
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
    <field id="settingsSaved" type="boolean" alwaysNotify="true" />
    <field id="savedSettings" type="assocarray" />
    <function name="openSettings" />
  </interface>
  <children>
    <Dialog
      id="settingsDialog"
      title="Settings"
      dialogWidth="1560"
      dialogHeight="820"
      contentComponentName="SettingsContent" />
  </children>
</component>
