<?xml version="1.0" encoding="utf-8"?>
<component name="SettingsContent" extends="Group" focusable="true">
  <script type="text/brightscript" uri="pkg:/source/store/SettingsStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Settings/SettingsContent.brs" />
  <interface>
    <function name="focusFirstField" />
    <function name="focusLastField" />
    <function name="getSettingsValues" />
    <function name="loadSettingsValues" />
    <function name="canMoveFocusToButtons" />
  </interface>
  <children>

    <!-- view library as... -->
    <Label
      id="displayLabel"
      text="View libary as..."
      width="560"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="displayOptions"
      translation="[20,48]"
      itemSize="[560,48]"
      numRows="2"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />

    <!-- series display -->
    <Label
      id="seriesLabel"
      translation="[0,172]"
      text="Display series as..."
      width="560"
      height="36"
      font="font:MediumBoldSystemFont" />
    <RadioButtonList
      id="seriesOptions"
      translation="[0,220]"
      itemSize="[560,48]"
      numRows="2"
      checkedItem="0"
      vertFocusAnimationStyle="floatingFocus"
      fadeFocusFeedbackWhenAutoScrolling="false"
      focusFootprintBitmapUri="pkg:/images/focus/transparent_focus_footprint.9.png" />
  </children>
</component>
