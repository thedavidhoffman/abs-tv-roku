<?xml version="1.0" encoding="utf-8"?>
<component name="GridView_Item" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Formatting.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Library/GridView/GridView_Item.brs" />
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
    <field id="focusPercent" type="float" onChange="onFocusPercentChanged" />
  </interface>
  <children>
    <Poster
      id="poster"
      width="280"
      height="280"
      uri="pkg:/images/placeholder_cover.png"
      loadDisplayMode="scaleToFit" />
    <Rectangle
      id="seriesTitleOverlay"
      width="280"
      height="240"
      color="0x000000AA"
      visible="false" />
    <Label
      id="seriesTitleLabel"
      translation="[10,0]"
      width="260"
      height="280"
      maxLines="3"
      wrap="true"
      horizAlign="center"
      vertAlign="center"
      font="font:TinyBoldSystemFont"
      color="0xF3F7FBFF"
      visible="false" />
    <Rectangle
      id="seriesOverlay"
      translation="[0,240]"
      width="280"
      height="40"
      color="0x000000FF"
      visible="false" />
    <Label
      id="seriesLabel"
      translation="[100,250]"
      width="256"
      height="26"
      maxLines="1"
      font="font:TinyBoldSystemFont"
      color="0xF3F7FBFF"
      visible="false" />
  </children>
</component>
