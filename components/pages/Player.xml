<?xml version="1.0" encoding="utf-8"?>
<component name="Player" extends="Group">
  <script type="text/brightscript" uri="pkg:/source/Formatting.brs" />
  <script type="text/brightscript" uri="pkg:/components/pages/Player.brs" />
  <interface>
    <field id="playRequest" type="assocarray" onChange="onPlayRequestChanged" />
    <field id="closeRequested" type="integer" />
    <field id="errorResponse" type="assocarray" />
  </interface>
  <children>
    <Rectangle id="playerBg" width="1920" height="1080" color="08111DFF" />
    <Poster
      id="cover"
      translation="[120,180]"
      width="420"
      height="420"
      uri="pkg:/images/placeholder_cover.png"
      loadDisplayMode="best-fit"
    />
    <Label id="titleLabel" translation="[620,210]" width="1040" numLines="3" wrap="true" color="F3F7FBFF" font="font:LargeBoldSystemFont" />
    <Label id="authorLabel" translation="[620,350]" width="1040" numLines="1" color="B7C5D4FF" />
    <Label id="narratorLabel" translation="[620,390]" width="1040" numLines="1" color="B7C5D4FF" />
    <Rectangle id="descriptionFocusRing" translation="[614,438]" width="1052" height="188" color="E09B4200" />
    <Label id="descriptionLabel" translation="[620,445]" width="1040" numLines="5" wrap="true" color="F3F7FBFF" font="font:SmallestSystemFont" />
    <Label id="publisherLabel" translation="[620,660]" width="340" numLines="1" color="B7C5D4FF" />
    <Label id="publishDateLabel" translation="[980,660]" width="300" numLines="1" color="B7C5D4FF" />
    <Label id="durationLabel" translation="[1300,660]" width="320" numLines="1" color="B7C5D4FF" />
    <Label id="statusLabel" translation="[620,740]" width="1040" numLines="2" wrap="true" color="F2C879FF" />
    <Group id="progressGroup" translation="[620,830]">
      <Rectangle id="progressTrack" width="1040" height="12" color="555555FF" />
      <Rectangle id="progressFill" width="1" height="12" color="E09B42FF" visible="false" />
      <Label id="currentTimeLabel" translation="[0,26]" width="220" text="0:00" color="B7C5D4FF" />
      <Label id="totalTimeLabel" translation="[820,26]" width="220" horizAlign="right" text="0:00" color="B7C5D4FF" />
    </Group>
    <Group id="transportControls" translation="[620,905]">
      <PrimaryButton id="rewindButton" translation="[0,0]" buttonWidth="160" buttonHeight="56" text="-30s" />
      <PrimaryButton id="playPauseButton" translation="[190,0]" buttonWidth="220" buttonHeight="56" text="Pause" />
      <PrimaryButton id="forwardButton" translation="[440,0]" buttonWidth="160" buttonHeight="56" text="+30s" />
    </Group>
    <Timer id="progressTimer" duration="1" repeat="true" />
    <Label id="hintLabel" translation="[620,980]" width="1040" text="Press Back to return to the library." color="91A3B6FF" />
    <Audio id="audioPlayer" />
    <AppTask id="playbackApiTask" />

    <Group id="descriptionModal" visible="false">
      <Rectangle id="descriptionModalBackdrop" width="1920" height="1080" color="000000FF" />
      <Rectangle id="descriptionModalPanel" translation="[300,150]" width="1320" height="780" color="101B2BFF" />
      <Label id="modalTitleLabel" translation="[360,205]" width="1200" text="Description" color="F3F7FBFF" font="font:LargeBoldSystemFont" />
      <Group id="modalDescriptionViewport" translation="[360,285]" clippingRect="[0,0,1120,450]">
        <Label id="modalDescriptionLabel" translation="[0,0]" width="1120" wrap="true" color="F3F7FBFF" />
      </Group>
      <Rectangle id="modalScrollbarTrack" translation="[1552,285]" width="8" height="450" color="555555FF" />
      <Rectangle id="modalScrollbarThumb" translation="[1552,285]" width="8" height="80" color="E09B42FF" />
      <PrimaryButton id="modalCloseButton" translation="[1300,830]" buttonWidth="260" buttonHeight="56" text="Close" />
    </Group>
  </children>
</component>
