<?xml version="1.0" encoding="utf-8"?>
<component name="PrimaryButton" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/controls/PrimaryButton.brs" />
  <interface>
    <field id="text" type="string" onChange="onTextChanged" />
    <field id="iconUri" type="string" onChange="onIconUriChanged" />
    <field id="buttonWidth" type="float" onChange="onDimensionsChanged" />
    <field id="buttonHeight" type="float" onChange="onDimensionsChanged" />
    <field id="hasFocusVisual" type="boolean" onChange="onFocusVisualChanged" />
  </interface>
  <children>
    <Rectangle id="bg" width="300" height="56" color="E09B42FF" />
    <Poster id="icon" visible="false" width="24" height="24" loadDisplayMode="scaleToFit" />
    <Label id="textLabel" translation="[0,12]" width="300" horizAlign="center" color="0F1A2AFF" />
  </children>
</component>
