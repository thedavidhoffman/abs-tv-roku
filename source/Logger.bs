import "pkg:/source/Format.bs"

class Logger

    private label as string

    '---------------------------------------------------------------------------
    ' Logger.new
    '---------------------------------------------------------------------------
    sub new(label = "" as string)
        m.label = label
    end sub

    '---------------------------------------------------------------------------
    ' Logger.write
    '---------------------------------------------------------------------------
    function write(message as dynamic) as object

        line = m.__format(message, m.label)
        ? line

        return m

    end function

    '---------------------------------------------------------------------------
    ' Logger.writeBracketed
    '---------------------------------------------------------------------------
    function writeBracketed(values as dynamic) as object

        output = ""

        for each line in values
            output = output + "[" + line + "] "
        end for

        m.write(output)

        return m

    end function

    '---------------------------------------------------------------------------
    ' Logger.writeJson
    '---------------------------------------------------------------------------
    function writeJson(jsonText as dynamic, indent = 0 as integer) as object
        lines = m.__formatJsonText(jsonText)
        prefix = m.__indent(indent)

        for each line in lines
            m.write(prefix + line)
        end for

        return m
    end function

    '---------------------------------------------------------------------------
    ' Logger.error
    '---------------------------------------------------------------------------
    function error(message as dynamic) as object

        message = "ERROR: " + message
        return m.write(message)

    end function

    '---------------------------------------------------------------------------
    ' Logger.__format
    '---------------------------------------------------------------------------
    function __format(message as dynamic, label as dynamic) as string

        text = Format.SafeString(message, "")
        if label <> invalid and label <> "" then text = "[" + label + "] " + text
        return m.__timestampPrefix() + text

    end function

    '---------------------------------------------------------------------------
    ' Logger.__formatJsonText
    '---------------------------------------------------------------------------
    function __formatJsonText(jsonText as dynamic) as object
        text = Format.SafeString(jsonText, "")
        lines = []
        if text = "" then
            lines.Push("")
            return lines
        end if

        indentLevel = 0
        currentLine = ""
        inString = false
        escapeNext = false
        quote = Chr(34)

        for i = 1 to Len(text)
            char = Mid(text, i, 1)

            if inString = true then
                currentLine = currentLine + char

                if escapeNext = true then
                    escapeNext = false
                else if char = "\" then
                    escapeNext = true
                else if char = quote then
                    inString = false
                end if
            else if char = quote then
                inString = true
                currentLine = currentLine + char
            else if char = "{" or char = "[" then
                currentLine = m.__trimRight(currentLine) + char
                lines.Push(currentLine)
                indentLevel = indentLevel + 1
                currentLine = m.__indent(indentLevel)
            else if char = "}" or char = "]" then
                if m.__trim(currentLine) <> "" then lines.Push(m.__trimRight(currentLine))
                indentLevel = indentLevel - 1
                if indentLevel < 0 then indentLevel = 0
                currentLine = m.__indent(indentLevel) + char
            else if char = "," then
                currentLine = m.__trimRight(currentLine) + char
                lines.Push(currentLine)
                currentLine = m.__indent(indentLevel)
            else if char = ":" then
                currentLine = m.__trimRight(currentLine) + ": "
            else if m.__isWhitespace(char) <> true then
                currentLine = currentLine + char
            end if
        end for

        if m.__trim(currentLine) <> "" then lines.Push(m.__trimRight(currentLine))

        return lines
    end function

    '---------------------------------------------------------------------------
    ' Logger.__indent
    '---------------------------------------------------------------------------
    function __indent(level as integer) as string
        text = ""
        for i = 1 to level
            text = text + "  "
        end for

        return text
    end function

    '---------------------------------------------------------------------------
    ' Logger.__isWhitespace
    '---------------------------------------------------------------------------
    function __isWhitespace(char as string) as boolean
        return char = " " or char = Chr(9) or char = Chr(10) or char = Chr(13)
    end function

    '---------------------------------------------------------------------------
    ' Logger.__trim
    '---------------------------------------------------------------------------
    function __trim(text as string) as string
        return m.__trimLeft(m.__trimRight(text))
    end function

    '---------------------------------------------------------------------------
    ' Logger.__trimLeft
    '---------------------------------------------------------------------------
    function __trimLeft(text as string) as string
        while Len(text) > 0 and m.__isWhitespace(Left(text, 1)) = true
            text = Mid(text, 2)
        end while

        return text
    end function

    '---------------------------------------------------------------------------
    ' Logger.__trimRight
    '---------------------------------------------------------------------------
    function __trimRight(text as string) as string
        while Len(text) > 0 and m.__isWhitespace(Right(text, 1)) = true
            text = Left(text, Len(text) - 1)
        end while

        return text
    end function

    '---------------------------------------------------------------------------
    ' Logger.__timestampPrefix
    '---------------------------------------------------------------------------
    function __timestampPrefix() as string
        dateTime = CreateObject("roDateTime")
        dateTime.ToLocalTime()

        return m.__pad2(dateTime.GetMonth()) + "-" + m.__pad2(dateTime.GetDayOfMonth()) + " " + m.__pad2(dateTime.GetHours()) + ":" + m.__pad2(dateTime.GetMinutes()) + ":" + m.__pad2(dateTime.GetSeconds()) + "." + m.__pad3(dateTime.GetMilliseconds()) + " "
    end function

    '---------------------------------------------------------------------------
    ' Logger.__pad2
    '---------------------------------------------------------------------------
    function __pad2(value as dynamic) as string
        text = int(val(value.ToStr())).ToStr()
        if Len(text) < 2 then return "0" + text
        return text
    end function

    '---------------------------------------------------------------------------
    ' Logger.__pad3
    '---------------------------------------------------------------------------
    function __pad3(value as dynamic) as string
        text = int(val(value.ToStr())).ToStr()
        while Len(text) < 3
            text = "0" + text
        end while

        return text
    end function

end class
